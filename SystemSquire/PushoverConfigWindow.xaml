<Window x:Class="SystemSquire.PushoverConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pushover Configuration"
    Height="860"
    Width="1360"
    MinHeight="700"
    MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
    ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6F6F6F"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunningAppsComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadableSelectorComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6F6F6F"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ContentPresenter Margin="0,0,24,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Fill="{TemplateBinding Foreground}"
                                              Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2D2D2D"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D5A8F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pushover Notifications"
                   Grid.Row="0"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,4"/>

        <TextBlock Text="Configure API keys and choose which events should send notifications."
                   Grid.Row="1"
                   Foreground="#AFAFAF"
                   FontSize="13"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="#2D2D2D"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Credentials"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="EnablePushoverCheckBox"
                              Content="Enable Pushover notifications"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,10"
                              Click="AutoSaveCheckBox_Click"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="App Token:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="ApiTokenBox" Grid.Column="1" LostFocus="AutoSaveTextBox_LostFocus"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="User Key:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="UserKeyBox" Grid.Column="1" LostFocus="AutoSaveTextBox_LostFocus"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2"
                    Background="#2D2D2D"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Events"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="NotifyAppStartCheckBox"
                              Content="Send when System Squire starts"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,6"
                              Click="AutoSaveCheckBox_Click"/>

                    <CheckBox x:Name="NotifyAppCloseCheckBox"
                              Content="Send when System Squire exits"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,6"
                              Click="AutoSaveCheckBox_Click"/>

                    <CheckBox x:Name="NotifyInactivityCheckBox"
                              Content="Send when there is no user input"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,6"
                              Click="AutoSaveCheckBox_Click"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Inactivity Interval (min):"
                               Grid.Column="0"
                               VerticalAlignment="Center"/>

                        <TextBox x:Name="InactivityMinutesBox"
                                 Grid.Column="1"
                                 HorizontalContentAlignment="Center"
                                 Text="30"
                                 Margin="8,0,8,0"
                                 LostFocus="AutoSaveTextBox_LostFocus"/>

                        <TextBlock Grid.Column="2"
                                   Text="Minutes before first idle alert"
                                   Foreground="#B8B8B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox x:Name="RepeatInactivityCheckBox"
                              Content="Repeat while still idle"
                              Foreground="White"
                              FontSize="13"
                              Margin="0,8,0,0"
                              IsChecked="True"
                              Click="AutoSaveCheckBox_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0"
                    Background="#2D2D2D"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Apps To Watch For Start/Close"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Add running apps below; they will be monitored continuously while System Squire is running."
                               Foreground="#B8B8B8"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="WatchedAppsComboBox"
                                  Grid.Column="0"
                                  Style="{StaticResource ReadableSelectorComboBox}"
                                  Height="35"
                                  ItemContainerStyle="{StaticResource RunningAppsComboBoxItemStyle}"
                                  Margin="0,0,8,0">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E0E0E0"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                            </ComboBox.Resources>
                        </ComboBox>

                        <Button Content="Add"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="AddWatchedApp_Click"/>

                        <Button Content="Refresh"
                                Grid.Column="2"
                                Click="RefreshWatchedApps_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Application"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Start"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="Close"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox x:Name="LifecycleAppsListBox"
                                     Height="230"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#3E3E42"
                                     BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>

                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding NotifyOnStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="LifecycleEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding NotifyOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="LifecycleEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Button Content="Remove"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Click="RemoveWatchedApp_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2"
                    Background="#2D2D2D"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Folders To Watch"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Monitors all files in each folder and all subfolders by polling file modified dates and existence."
                               Foreground="#B8B8B8"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="FolderPathBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 ToolTip="Enter a full folder path"/>

                        <Button Content="Browse"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="BrowseFolder_Click"/>

                        <Button Content="Add Folder"
                                Grid.Column="2"
                                Click="AddFolderWatch_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                           <Label Content="Polling Rate (sec):"
                               Grid.Column="0"
                               VerticalAlignment="Center"/>
                           <TextBox x:Name="FolderPollingSecondsBox"
                                 Grid.Column="1"
                                 HorizontalContentAlignment="Center"
                               Text="60"
                               LostFocus="AutoSaveTextBox_LostFocus"/>

                        <Label Content="Folder Inactivity (min):"
                               Grid.Column="3"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="FolderInactivityMinutesBox"
                                 Grid.Column="4"
                                 HorizontalContentAlignment="Center"
                                 Text="10"
                                 LostFocus="AutoSaveTextBox_LostFocus"/>

                        <TextBlock Grid.Column="5"
                                   Text="Default polling: 60 sec"
                                   Foreground="#B8B8B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <CheckBox x:Name="RepeatFolderInactivityCheckBox"
                              Content="Repeat folder inactivity alerts while still inactive"
                              Foreground="White"
                              FontSize="13"
                              Margin="0,0,0,8"
                              IsChecked="True"
                              Click="AutoSaveCheckBox_Click"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Folder"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Create"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="Remove"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="Modify"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           Text="Idle"
                                           Foreground="#B8B8B8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox x:Name="FolderWatchListBox"
                                     Height="230"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="#3E3E42"
                                     BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="68"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FolderPath}"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FolderPath}"/>

                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding NotifyOnCreated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="FolderEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding NotifyOnRemoved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="FolderEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="3"
                                                      IsChecked="{Binding NotifyOnModified, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="FolderEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <CheckBox Grid.Column="4"
                                                      IsChecked="{Binding NotifyOnInactivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="FolderEntryChanged_Click"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Button Content="Remove"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Click="RemoveFolderWatch_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Close"
                    Background="#0E8C0E"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
