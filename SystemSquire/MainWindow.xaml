<Window x:Class="SystemSquire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="System Squire"
    Height="963" Width="1240"
    MinHeight="963" MinWidth="1240"
        Icon="Assets/system-squire-icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E"
    Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunningAppsComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadableSelectorComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6F6F6F"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D5A8F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Width" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E8C0E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10A010"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="Assets/system-squire-icon.ico"
                        ToolTipText="System Squire">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#2D2D2D">
                    <MenuItem Header="Show Window" Click="MenuItem_Show_Click" Foreground="White"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuItem_Exit_Click" Foreground="White"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid Margin="20,20,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleTextBlock"
                       Text="⚙️ System Squire"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="Advanced System Control and Hotkey Manager"
                       FontSize="15"
                       Foreground="#888888"
                       HorizontalAlignment="Left"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusLabelText"
                           Text="Status:"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusIndicator"
                         Width="12"
                         Height="12"
                         Fill="#2ECC71"
                         Margin="10,0,10,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Monitoring Active"
                           FontSize="16"
                           Foreground="#2ECC71"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Hotkey Configuration"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Shutdown:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="ShutdownHotkeyBox" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True"/>
                        <Button Content="⏺ Record" Grid.Column="2" Style="{StaticResource RecordButton}" Click="RecordShutdownHotkey_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Blackout:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="BlackoutHotkeyBox" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True"/>
                        <Button Content="⏺ Record" Grid.Column="2" Style="{StaticResource RecordButton}" Click="RecordBlackoutHotkey_Click"/>
                    </Grid>

                    <TextBlock Text="General"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="DarkModeCheckBox"
                              Content="Dark Mode (Restart required)"
                              Foreground="White"
                              FontSize="14"
                              IsChecked="True"
                              Margin="0,0,0,10"/>

                    <CheckBox x:Name="StartMinimizedCheckBox"
                              Content="Start Minimized to Tray"
                              Foreground="White"
                              FontSize="14"
                              IsChecked="True"/>

                    <Border Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Network"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <CheckBox x:Name="EthernetWolCheckBox"
                                      Content="Enable Wake-on-LAN (Ethernet)"
                                      Foreground="White"
                                      FontSize="14"
                                      Click="EthernetWolCheckBox_Click"/>

                            <TextBlock x:Name="EthernetWolStatusText"
                                       Text="Checking adapter state..."
                                       FontSize="12"
                                       Foreground="#B8B8B8"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#2D2D2D"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Watch Apps At Launch"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="If a listed app starts during the watch window, System Squire runs: minimize-to-tray /NONOTIFY &lt;name&gt;"
                                       FontSize="12"
                                       Foreground="#B8B8B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Watch Duration (minutes):"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="LaunchWatchDurationBox"
                                         Grid.Column="1"
                                         Margin="8,0,8,0"
                                         HorizontalContentAlignment="Center"
                                         Text="1"/>
                                <TextBlock Grid.Column="2"
                                           Text="Default: 1"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Delay Before Minimize (sec):"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="LaunchMinimizeDelayBox"
                                         Grid.Column="1"
                                         Margin="8,0,8,0"
                                         HorizontalContentAlignment="Center"
                                         Text="0"/>
                                <TextBlock Grid.Column="2"
                                           Text="Runs once; 0 = immediate"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="LaunchWatchAppsComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource ReadableSelectorComboBox}"
                                          Height="35"
                                          ItemContainerStyle="{StaticResource RunningAppsComboBoxItemStyle}"
                                          Margin="0,0,10,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E0E0E0"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <Button Content="Add" Grid.Column="1" Margin="0,0,10,0" Click="AddLaunchWatchApp_Click"/>
                                <Button Content="Refresh" Grid.Column="2" Click="RefreshLaunchWatchApps_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="AppsToWatchAtLaunchListBox"
                                         Grid.Column="0"
                                         Height="170"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#3E3E42"
                                         BorderThickness="1"
                                         Margin="0,0,10,0"/>

                                <Button Content="Remove" Grid.Column="1" VerticalAlignment="Top" Click="RemoveLaunchWatchApp_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#2D2D2D"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Kill Apps Before Shutdown"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="RunningAppsComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource ReadableSelectorComboBox}"
                                          Height="35"
                                          ItemContainerStyle="{StaticResource RunningAppsComboBoxItemStyle}"
                                          Margin="0,0,10,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E0E0E0"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <Button Content="Add" Grid.Column="1" Margin="0,0,10,0" Click="AddSelectedApp_Click"/>
                                <Button Content="Refresh" Grid.Column="2" Click="RefreshRunningApps_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="AppsToKillListBox"
                                         Grid.Column="0"
                                         Height="170"
                                         Background="#1E1E1E"
                                         Foreground="White"
                                         BorderBrush="#3E3E42"
                                         BorderThickness="1"
                                         Margin="0,0,10,0"/>

                                <Button Content="Remove" Grid.Column="1" VerticalAlignment="Top" Click="RemoveSelectedApp_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="FooterTextBlock"
                   Grid.Row="3"
                   Text="System Squire v2.0 • Made with C# WPF"
                   FontSize="12"
                   Foreground="#666666"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,10"/>

        <Button Grid.Row="4"
                Content="💾 Save Configuration"
                Style="{StaticResource SaveButton}"
                HorizontalAlignment="Stretch"
                Click="SaveConfig_Click"/>
    </Grid>
</Window>
