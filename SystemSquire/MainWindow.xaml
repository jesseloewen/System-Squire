<Window x:Class="SystemSquire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="System Squire"
        Height="978" Width="985"
        MinHeight="978" MinWidth="985"
        Icon="Assets/system-squire-icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunningAppsComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadableSelectorComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6F6F6F"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ContentPresenter Margin="0,0,24,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Fill="{TemplateBinding Foreground}"
                                              Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2D2D2D"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D5A8F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Width" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TrayMenuCheckGlyph"
                                           Grid.Column="0"
                                           Text="✓"
                                           Foreground="#F3F3F3"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrayMenuCheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3E3E42" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="Assets/system-squire-icon.ico"
                        ToolTipText="System Squire">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}"
                             Opened="TrayContextMenu_Opened">
                    <MenuItem Header="Shutdown"
                              Click="MenuItem_Shutdown_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <MenuItem Header="Monitor Blackout"
                              Click="MenuItem_Blackout_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <Separator Style="{StaticResource TrayContextMenuSeparatorStyle}"/>
                    <MenuItem x:Name="TrayMenuToggleWolItem"
                              Header="Wake-on-LAN (Ethernet)"
                              IsCheckable="True"
                              Click="MenuItem_ToggleWol_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <MenuItem x:Name="TrayMenuToggleNotificationsItem"
                              Header="Notifications Enabled"
                              IsCheckable="True"
                              Click="MenuItem_ToggleNotifications_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <MenuItem x:Name="TrayMenuToggleWebServiceItem"
                              Header="Web Service Running"
                              IsCheckable="True"
                              Click="MenuItem_ToggleWebService_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <MenuItem x:Name="TrayMenuRestartWebServiceItem"
                              Header="Restart Web Service"
                              Click="MenuItem_RestartWebService_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <Separator Style="{StaticResource TrayContextMenuSeparatorStyle}"/>
                    <MenuItem Header="Show Window"
                              Click="MenuItem_Show_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                    <MenuItem Header="Exit"
                              Click="MenuItem_Exit_Click"
                              Style="{StaticResource TrayContextMenuItemStyle}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/system-squire-icon.png"
                           Width="30"
                           Height="30"
                           Stretch="Uniform"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleTextBlock"
                               Text="System Squire"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="Advanced System Control and Hotkey Manager"
                           FontSize="13"
                           Foreground="#888888"
                           HorizontalAlignment="Left"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Updates"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="UpdateStatusIndicator"
                                 Width="10"
                                 Height="10"
                                 Fill="#B8B8B8"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Checking for updates..."
                                   Foreground="#B8B8B8"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <CheckBox x:Name="AutoCheckForUpdatesCheckBox"
                              Content="Auto-check for updates"
                              Foreground="White"
                              FontSize="12"
                              Margin="0,8,0,0"
                              IsChecked="True"
                              Click="MainSettingChanged_Click"/>

                    <CheckBox x:Name="AutoDownloadUpdatesCheckBox"
                              Content="Auto-download updates"
                              Foreground="White"
                              FontSize="12"
                              Margin="0,4,0,0"
                              IsChecked="True"
                              Click="MainSettingChanged_Click"/>

                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Check"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="CheckForUpdatesButton_Click"/>

                        <Button x:Name="DownloadAndInstallUpdateButton"
                                Content="Download"
                                MinWidth="164"
                                Background="#2E7D32"
                                Visibility="Collapsed"
                                Click="DownloadAndInstallUpdateButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock x:Name="StatusLabelText"
                           Text="Status:"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusIndicator"
                         Width="10"
                         Height="10"
                         Fill="#2ECC71"
                         Margin="8,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Monitoring Active"
                           FontSize="15"
                           Foreground="#2ECC71"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Border Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hotkeys and Quick Actions"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Shutdown:" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShutdownHotkeyBox" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Content="Record" Grid.Column="2" Style="{StaticResource RecordButton}" Click="RecordShutdownHotkey_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Blackout:" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="BlackoutHotkeyBox" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Content="Record" Grid.Column="2" Style="{StaticResource RecordButton}" Click="RecordBlackoutHotkey_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Shutdown Delay:" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShutdownCountdownSecondsBox"
                                         Grid.Column="1"
                                         Margin="0,0,8,0"
                                         HorizontalContentAlignment="Center"
                                         Text="10"
                                         LostFocus="MainSettingChanged_LostFocus"/>
                                <TextBlock Grid.Column="2"
                                           Text="Seconds, 0 = immediate"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <CheckBox x:Name="StartAtSystemStartupCheckBox"
                                      Content="Start at System Startup"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,0,0,6"
                                      IsChecked="False"
                                      Click="MainSettingChanged_Click"/>

                            <CheckBox x:Name="StartMinimizedCheckBox"
                                      Content="Start Minimized to Tray"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,0,0,6"
                                      IsChecked="False"
                                      Click="MainSettingChanged_Click"/>

                            <CheckBox x:Name="EthernetWolCheckBox"
                                      Content="Enable Wake-on-LAN (Ethernet)"
                                      Foreground="White"
                                      FontSize="14"
                                      Click="EthernetWolCheckBox_Click"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Blackout keys:"
                                           Foreground="#B8B8B8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <CheckBox x:Name="BlackoutTurnOffCapsLockCheckBox"
                                          Content="Caps"
                                          Foreground="White"
                                          FontSize="13"
                                          Margin="0,0,10,0"
                                          Click="MainSettingChanged_Click"/>

                                <CheckBox x:Name="BlackoutTurnOffNumLockCheckBox"
                                          Content="Num"
                                          Foreground="White"
                                          FontSize="13"
                                          Margin="0,0,10,0"
                                          Click="MainSettingChanged_Click"/>

                                <CheckBox x:Name="BlackoutTurnOffScrollLockCheckBox"
                                          Content="Scroll"
                                          Foreground="White"
                                          FontSize="13"
                                          Margin="0,0,10,0"
                                          Click="MainSettingChanged_Click"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Dummy:"
                                           Foreground="#B8B8B8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <CheckBox x:Name="BlackoutOpenDummyWindowCheckBox"
                                          Content="Open on blackout"
                                          Foreground="White"
                                          FontSize="13"
                                          Margin="0,0,10,0"
                                          Click="MainSettingChanged_Click"/>

                                <Button x:Name="OpenDummyWindowButton"
                                        Content="Open Dummy"
                                        Padding="8,2"
                                        Margin="0,0,8,0"
                                        Click="OpenDummyWindowButton_Click"/>

                                <Button x:Name="CopyDummyWindowPathButton"
                                        Content="Copy Path"
                                        Padding="8,2"
                                        Click="CopyDummyWindowPathButton_Click"/>
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RunShutdownButton"
                                        Grid.Column="0"
                                        Content="Run Shutdown"
                                        Background="#A04040"
                                        Click="RunShutdownButton_Click"/>

                                <Button x:Name="ToggleBlackoutButton"
                                        Grid.Column="2"
                                        Content="Toggle Blackout"
                                        Background="#3E3E42"
                                        Click="ToggleBlackoutButton_Click"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="ConfigurePushoverButton"
                                        Grid.Column="0"
                                        Content="Pushover Notifications"
                                        Click="ConfigurePushover_Click"/>

                                <Button x:Name="TestPushoverNotificationButton"
                                        Grid.Column="2"
                                        Content="Send Test Notification"
                                        Background="#2E7D32"
                                        Click="TestPushoverNotification_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                    <Border Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="Web Remote Control"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Service Port:"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="WebServicePortBox"
                                         Grid.Column="1"
                                         HorizontalContentAlignment="Center"
                                         Margin="8,0,8,0"
                                         Text="7745"
                                         LostFocus="MainSettingChanged_LostFocus"/>
                                <TextBlock Grid.Column="2"
                                           Text="Default: 7745"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <CheckBox x:Name="WebServiceAutoStartCheckBox"
                                      Content="Start web service automatically with app"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,10,0,0"
                                      Click="MainSettingChanged_Click"/>

                            <CheckBox x:Name="AutoOpenWebPageOnStartupCheckBox"
                                      Content="Auto-open remote webpage on app startup"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,6,0,0"
                                      Click="MainSettingChanged_Click"/>

                            <CheckBox x:Name="WebRequirePasswordCheckBox"
                                      Content="Require password login for web remote"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,6,0,0"
                                      Click="WebRequirePasswordCheckBox_Click"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="WebPasswordBox"
                                             Grid.Column="0"
                                             PasswordChar="*"
                                             ToolTip="Set or replace the web remote password"/>

                                <Button x:Name="SetWebPasswordButton"
                                        Grid.Column="2"
                                        Content="Set Password"
                                        Click="SetWebPasswordButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="WebPasswordStatusText"
                                       Text="Web password is not set."
                                       FontSize="12"
                                       Foreground="#B8B8B8"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="WebServiceStatusText"
                                       Text="Web service is stopped."
                                       FontSize="12"
                                       Foreground="#B8B8B8"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="StartWebServiceButton"
                                        Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                        Content="Start"
                                        Click="StartWebService_Click"/>
                                <Button x:Name="StopWebServiceButton"
                                    Grid.Column="0"
                                        Content="Stop"
                                        Background="#A04040"
                                    Visibility="Collapsed"
                                        Click="StopWebService_Click"/>
                                <Button x:Name="RestartWebServiceButton"
                                    Grid.Column="2"
                                        Content="Restart"
                                        Background="#8A5A2B"
                                        Click="RestartWebService_Click"/>
                                <Button x:Name="OpenWebPageButton"
                                    Grid.Column="4"
                                        Content="Open"
                                        Background="#0E639C"
                                        Click="OpenWebPage_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Border Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Watch Apps At Launch"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="If a listed app starts during the watch window, System Squire runs: minimize-to-tray /NONOTIFY &lt;name&gt;"
                                       FontSize="12"
                                       Foreground="#B8B8B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Watch Duration (minutes):"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="LaunchWatchDurationBox"
                                         Grid.Column="1"
                                         Margin="8,0,8,0"
                                         HorizontalContentAlignment="Center"
                                         Text="1"
                                         LostFocus="MainSettingChanged_LostFocus"/>
                                <TextBlock Grid.Column="2"
                                           Text="Default: 1"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Delay Before Minimize (sec):"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                                <TextBox x:Name="LaunchMinimizeDelayBox"
                                         Grid.Column="1"
                                         Margin="8,0,8,0"
                                         HorizontalContentAlignment="Center"
                                         Text="0"
                                         LostFocus="MainSettingChanged_LostFocus"/>
                                <TextBlock Grid.Column="2"
                                           Text="Runs once; 0 = immediate"
                                           Foreground="#9D9D9D"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="LaunchWatchAppsComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource ReadableSelectorComboBox}"
                                          Height="35"
                                          ItemContainerStyle="{StaticResource RunningAppsComboBoxItemStyle}"
                                          Margin="0,0,8,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E0E0E0"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <Button Content="Add" Grid.Column="1" Margin="0,0,8,0" Click="AddLaunchWatchApp_Click"/>
                                <Button Content="Refresh" Grid.Column="2" Click="RefreshLaunchWatchApps_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Border Background="#252526"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="On"
                                                       Foreground="#B8B8B8"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Application"
                                                       Foreground="#B8B8B8"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="AppsToWatchAtLaunchListBox"
                                             Height="110"
                                             Background="#1E1E1E"
                                             Foreground="White"
                                             BorderBrush="#3E3E42"
                                             BorderThickness="1"
                                             Margin="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="AppsListEntryCheckBox_Click"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Padding="4,2"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Button Content="Remove" Grid.Column="1" VerticalAlignment="Top" Click="RemoveLaunchWatchApp_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                    <Border Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="Kill Apps Before Shutdown"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="RunningAppsComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource ReadableSelectorComboBox}"
                                          Height="35"
                                          ItemContainerStyle="{StaticResource RunningAppsComboBoxItemStyle}"
                                          Margin="0,0,8,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E0E0E0"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <Button Content="Add" Grid.Column="1" Margin="0,0,8,0" Click="AddSelectedApp_Click"/>
                                <Button Content="Refresh" Grid.Column="2" Click="RefreshRunningApps_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Border Background="#252526"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="On"
                                                       Foreground="#B8B8B8"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Application"
                                                       Foreground="#B8B8B8"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="AppsToKillListBox"
                                             Height="110"
                                             Background="#1E1E1E"
                                             Foreground="White"
                                             BorderBrush="#3E3E42"
                                             BorderThickness="1"
                                             Margin="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="AppsListEntryCheckBox_Click"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Padding="4,2"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Button Content="Remove" Grid.Column="1" VerticalAlignment="Top" Click="RemoveSelectedApp_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterTextBlock"
                       Grid.Column="0"
                       Text="System Squire • Version loading... • Made with C# WPF • Configs are stored in AppData"
                       FontSize="12"
                       Foreground="#666666"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <Button x:Name="ResetAllSettingsButton"
                    Grid.Column="1"
                    Content="Reset Settings"
                    MinWidth="106"
                    Height="30"
                    FontSize="12"
                    Padding="8,4"
                    Background="#A04040"
                    Click="ResetAllSettingsButton_Click"/>
        </Grid>
    </Grid>
</Window>
